# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database (docker compose publishes Postgres on localhost:5433; password = POSTGRES_PASSWORD in the root .env)
# Inside docker compose this is overridden to point at the "postgres" service.
DATABASE_URL=postgresql://latike:change-me@localhost:5433/latike_db

# JWT (at least 16 characters each; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QR code signing secret (at least 16 characters). Changing it invalidates all issued tickets.
QR_SECRET_KEY=

# Payments
# "mock" completes purchases without Stripe (for testing the mobile app).
# "stripe" requires STRIPE_SECRET_KEY. Defaults to stripe when a real key is set, otherwise mock.
PAYMENTS_MODE=mock
CURRENCY=pln
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (event image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (NodeMailer). Leave EMAIL_USER empty to skip sending ticket emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@latike.com

# CORS (browser clients only; the mobile app is not affected)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:3001
CORS_ORIGIN=

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
