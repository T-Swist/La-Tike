generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  HOST
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  role          UserRole @default(CUSTOMER)
  isVerified    Boolean  @default(false)
  profileImage  String?
  refreshToken  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events        Event[]
  orders        Order[]
  checkIns      CheckIn[]

  @@index([email])
  @@index([role])
  @@index([refreshToken])
  @@map("users")
}

model Event {
  id              String      @id @default(uuid())
  hostId          String
  title           String
  description     String      @db.Text
  category        String
  location        String
  venue           String?
  address         String?
  city            String?
  state           String?
  country         String?
  latitude        Float?
  longitude       Float?
  startDate       DateTime
  endDate         DateTime
  coverImage      String?
  images          String[]
  status          EventStatus @default(DRAFT)
  isFeatured      Boolean     @default(false)
  totalCapacity   Int?
  tags            String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  host            User        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  ticketTypes     TicketType[]
  orders          Order[]
  tickets         Ticket[]

  @@index([hostId])
  @@index([status])
  @@index([startDate])
  @@index([category])
  @@map("events")
}

model TicketType {
  id              String   @id @default(uuid())
  eventId         String
  name            String
  description     String?
  price           Float
  quantity        Int
  sold            Int      @default(0)
  minPerOrder     Int      @default(1)
  maxPerOrder     Int      @default(10)
  salesStartDate  DateTime?
  salesEndDate    DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets         Ticket[]

  @@index([eventId])
  @@map("ticket_types")
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  eventId         String
  totalAmount     Float
  serviceFee      Float       @default(0)
  platformFee     Float       @default(0)
  status          OrderStatus @default(PENDING)
  items           Json?
  paymentId       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event           Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets         Ticket[]
  payment         Payment?

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("orders")
}

model Ticket {
  id              String       @id @default(uuid())
  orderId         String
  eventId         String
  ticketTypeId    String
  qrCode          String       @unique
  qrHash          String
  status          TicketStatus @default(VALID)
  holderName      String?
  holderEmail     String?
  scannedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType      TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  checkIns        CheckIn[]

  @@index([orderId])
  @@index([eventId])
  @@index([qrCode])
  @@index([status])
  @@map("tickets")
}

model Payment {
  id                  String        @id @default(uuid())
  orderId             String        @unique
  amount              Float
  currency            String        @default("usd")
  status              PaymentStatus @default(PENDING)
  stripePaymentId     String?       @unique
  stripePaymentIntent String?
  paymentMethod       String?
  receiptUrl          String?
  refundId            String?
  refundedAmount      Float?
  metadata            Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([stripePaymentId])
  @@index([status])
  @@map("payments")
}

model CheckIn {
  id              String   @id @default(uuid())
  ticketId        String
  scannedBy       String
  scannedAt       DateTime @default(now())
  location        String?
  deviceInfo      String?

  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  scanner         User     @relation(fields: [scannedBy], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([scannedBy])
  @@map("check_ins")
}
